# Copy to .env.local for local development. Never commit real .env files.
# This foundation runs without AWS, Supabase, or PostgreSQL.

# Node process environment: development | test | production
NODE_ENV=development

# SchoolOS deployment environment. Required.
# local | test | dev | staging | production
APP_ENV=local

# Structured log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Authentication adapter. "fake" is allowed only for local and test.
# "supabase" is reserved for M1 step 3 and is not implemented yet.
AUTH_PROVIDER=fake

# Safe to expose to the browser. Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=SchoolOS

# Reserved for later M1 steps. Do not set these until the corresponding step.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_ISSUER=
