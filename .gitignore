# Dependencies
node_modules/
.pnpm-store/
vendor/

# Next.js / build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Go (future agent)
/agent/bin/
*.exe
*.test
*.out

# Testing / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# Environment and secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*credentials*.json
*service-account*.json
client_secret*.json
secrets/
.secrets/

# Local databases and data dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
/data/
/tmp/

# Supabase local
supabase/.branches/
supabase/.temp/

# Infrastructure-as-code state (contains secrets)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Cursor: keep shared project rules, ignore everything else local
.cursor/*
!.cursor/rules/
