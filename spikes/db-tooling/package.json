{
  "name": "schoolos-spike-db-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Throwaway ADR-0014 compatibility spike: dbmate + Kysely + node-postgres on PostgreSQL 18.6. Not application code.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "db:reset": "bash scripts/reset-db.sh",
    "db:migrate": "bash scripts/dbmate.sh up",
    "db:rollback": "bash scripts/dbmate.sh rollback",
    "db:types": "bash scripts/codegen.sh",
    "db:types:check": "bash scripts/codegen.sh --verify",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "spike": "bash scripts/run-spike.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "dbmate": "2.37.0",
    "kysely": "0.29.7",
    "kysely-codegen": "0.20.0",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
